generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  usuarioId        Int      @id @default(autoincrement())
  nombreUsuario    String   @unique
  correoElectronico String   @unique
  contrasena       String
  elo              Int      @default(1200)
  victorias        Int      @default(0)
  derrotas         Int      @default(0)
  empates          Int      @default(0)
  fechaCreacion    DateTime @default(now())

  partidasBlancas  Game[]   @relation("JugadorBlanco")
  partidasNegras   Game[]   @relation("JugadorNegro")
}

model Game {
  partidaId        Int      @id @default(autoincrement())
  usuarioIdBlanco  Int
  usuarioIdNegro   Int
  estado           String   @default("activa") // activa, finalizada
  resultado        String?  // blanco, negro, tablas
  fechaCreacion    DateTime @default(now())
  fechaFinalizacion DateTime?

  jugadorBlanco    User     @relation("JugadorBlanco", fields: [usuarioIdBlanco], references: [usuarioId])
  jugadorNegro     User     @relation("JugadorNegro", fields: [usuarioIdNegro], references: [usuarioId])
}
